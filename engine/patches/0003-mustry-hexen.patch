diff --git a/src/hexen/mustry_stats.c b/src/hexen/mustry_stats.c
new file mode 100644
index 00000000..a6d8aa6e
--- /dev/null
+++ b/src/hexen/mustry_stats.c
@@ -0,0 +1,130 @@
+//
+// Mustry Doom: read-only player telemetry for the host page (Hexen).
+//
+// Same ids and semantics as src/doom/mustry_stats.c so the component reads
+// every game through one table. Hexen has no intermission counters, so the
+// kill/item/secret totals are 0; "ammo" is the mana of the ready weapon and
+// "armor" is the status bar's figure (class save + the four armor pieces).
+// Everything here is a plain read of engine globals; nothing is mutated.
+//
+
+#include <emscripten.h>
+
+#include "h2def.h"
+#include "p_local.h"
+#include "../d_loop.h"
+#include "../i_timer.h"
+#include "../net_client.h"
+
+extern int AutoArmorSave[NUMCLASSES];
+
+enum
+{
+    MSTAT_IN_LEVEL = 0,
+    MSTAT_HEALTH = 1,
+    MSTAT_ARMOR = 2,
+    MSTAT_AMMO = 3,       // mana for the ready weapon (the lower of the two for MANA_BOTH), -1 when it needs none
+    MSTAT_WEAPON = 4,     // weapontype_t of the ready weapon (0 = first weapon of the class)
+    MSTAT_KILLS = 5,
+    MSTAT_ITEMS = 6,
+    MSTAT_SECRETS = 7,
+    MSTAT_TOTAL_KILLS = 8,
+    MSTAT_TOTAL_ITEMS = 9,
+    MSTAT_TOTAL_SECRETS = 10,
+    MSTAT_EPISODE = 11,
+    MSTAT_MAP = 12,
+    MSTAT_LEVEL_SECONDS = 13,
+    MSTAT_DEAD = 14,
+    MSTAT_PAUSED = 15,
+    MSTAT_NETGAME = 16,
+    MSTAT_IN_LOBBY = 17,
+    MSTAT_NET_PLAYERS = 18,
+    MSTAT_CLASS = 19          // pclass_t: 0 fighter, 1 cleric, 2 mage, 3 pig
+};
+
+int Mustry_Stat(int id)
+{
+    player_t *p;
+    int in_level;
+
+    in_level = (gamestate == GS_LEVEL && gametic > 0 && !net_waiting_for_launch) ? 1 : 0;
+    p = &players[consoleplayer];
+
+    switch (id)
+    {
+        case MSTAT_IN_LEVEL:
+            return in_level;
+        case MSTAT_HEALTH:
+            return in_level ? p->health : 0;
+        case MSTAT_ARMOR:
+        {
+            int temp;
+            if (!in_level || p->class < 0 || p->class >= NUMCLASSES)
+                return 0;
+            temp = AutoArmorSave[p->class] + p->armorpoints[ARMOR_ARMOR] + p->armorpoints[ARMOR_SHIELD]
+                + p->armorpoints[ARMOR_HELMET] + p->armorpoints[ARMOR_AMULET];
+            return temp >> FRACBITS;
+        }
+        case MSTAT_AMMO:
+        {
+            manatype_t mana;
+            if (!in_level || p->class < 0 || p->class >= NUMCLASSES)
+                return 0;
+            mana = WeaponInfo[p->readyweapon][p->class].mana;
+            if (mana == MANA_NONE)
+                return -1;
+            if (mana == MANA_BOTH)
+                return p->mana[MANA_1] < p->mana[MANA_2] ? p->mana[MANA_1] : p->mana[MANA_2];
+            return p->mana[mana];
+        }
+        case MSTAT_WEAPON:
+            return in_level ? (int) p->readyweapon : 0;
+        case MSTAT_KILLS:
+            return in_level ? p->killcount : 0;
+        case MSTAT_ITEMS:
+            return in_level ? p->itemcount : 0;
+        case MSTAT_SECRETS:
+            return in_level ? p->secretcount : 0;
+        case MSTAT_TOTAL_KILLS:
+        case MSTAT_TOTAL_ITEMS:
+        case MSTAT_TOTAL_SECRETS:
+            return 0;
+        case MSTAT_EPISODE:
+            return gameepisode;
+        case MSTAT_MAP:
+            return gamemap;
+        case MSTAT_LEVEL_SECONDS:
+            return in_level ? leveltime / TICRATE : 0;
+        case MSTAT_DEAD:
+            return (in_level && p->playerstate == PST_DEAD) ? 1 : 0;
+        case MSTAT_PAUSED:
+            return paused ? 1 : 0;
+        case MSTAT_NETGAME:
+            return netgame ? 1 : 0;
+        case MSTAT_IN_LOBBY:
+            return net_waiting_for_launch ? 1 : 0;
+        case MSTAT_NET_PLAYERS:
+        {
+            int n = 0, i;
+            if (!netgame) return 0;
+            for (i = 0; i < MAXPLAYERS; i++) if (playeringame[i]) n++;
+            return n;
+        }
+        case MSTAT_CLASS:
+            return in_level ? (int) p->class : 0;
+        default:
+            return 0;
+    }
+}
+
+//
+// Save-game hook: G_DoSaveGame calls this after SV_SaveGame copied the base
+// slot into hex<N>.hxs plus one hex<N><map>.hxs per visited map of the hub,
+// all in -savedir. The host page reads every file of the slot from the
+// in-memory filesystem and persists them on the gateway per user.
+//
+EM_JS(void, Mustry_SaveGameWritten, (int slot), {
+    if (typeof Module.onDoomSaveGame === 'function') {
+        Module.onDoomSaveGame(slot);
+    }
+});
