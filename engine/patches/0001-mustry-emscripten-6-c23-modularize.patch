diff --git a/src/doom/mustry_stats.c b/src/doom/mustry_stats.c
new file mode 100644
index 00000000..8cd452e4
--- /dev/null
+++ b/src/doom/mustry_stats.c
@@ -0,0 +1,112 @@
+//
+// Mustry Doom: read-only player telemetry for the host page.
+//
+// Exported to JavaScript (see EXPORTED_FUNCTIONS in configure.ac) so the
+// Perspective component can poll the marine's state and publish it as
+// component outputs, which Ignition can then bind to tags and historize.
+// Everything here is a plain read of engine globals; nothing is mutated.
+//
+
+#include <emscripten.h>
+
+#include "doomstat.h"
+#include "d_player.h"
+#include "d_items.h"
+#include "p_local.h"
+#include "../net_client.h"
+
+enum
+{
+    MSTAT_IN_LEVEL = 0,   // 1 while a map is being played
+    MSTAT_HEALTH = 1,
+    MSTAT_ARMOR = 2,
+    MSTAT_AMMO = 3,       // ammo for the ready weapon, -1 when it needs none
+    MSTAT_WEAPON = 4,     // weapontype_t of the ready weapon (0 = fist)
+    MSTAT_KILLS = 5,
+    MSTAT_ITEMS = 6,
+    MSTAT_SECRETS = 7,
+    MSTAT_TOTAL_KILLS = 8,
+    MSTAT_TOTAL_ITEMS = 9,
+    MSTAT_TOTAL_SECRETS = 10,
+    MSTAT_EPISODE = 11,
+    MSTAT_MAP = 12,
+    MSTAT_LEVEL_SECONDS = 13,
+    MSTAT_DEAD = 14,      // 1 while the player is dead
+    MSTAT_PAUSED = 15,
+    MSTAT_NETGAME = 16,      // 1 in a multiplayer game
+    MSTAT_IN_LOBBY = 17,     // 1 while waiting in the netgame lobby
+    MSTAT_NET_PLAYERS = 18   // players in the netgame (0 single player)
+};
+
+int Mustry_Stat(int id)
+{
+    player_t *p;
+    int in_level;
+
+    in_level = (gamestate == GS_LEVEL && gametic > 0 && !net_waiting_for_launch) ? 1 : 0;
+    p = &players[consoleplayer];
+
+    switch (id)
+    {
+        case MSTAT_IN_LEVEL:
+            return in_level;
+        case MSTAT_HEALTH:
+            return in_level ? p->health : 0;
+        case MSTAT_ARMOR:
+            return in_level ? p->armorpoints : 0;
+        case MSTAT_AMMO:
+            if (!in_level)
+                return 0;
+            if (weaponinfo[p->readyweapon].ammo == am_noammo)
+                return -1;
+            return p->ammo[weaponinfo[p->readyweapon].ammo];
+        case MSTAT_WEAPON:
+            return in_level ? (int) p->readyweapon : 0;
+        case MSTAT_KILLS:
+            return in_level ? p->killcount : 0;
+        case MSTAT_ITEMS:
+            return in_level ? p->itemcount : 0;
+        case MSTAT_SECRETS:
+            return in_level ? p->secretcount : 0;
+        case MSTAT_TOTAL_KILLS:
+            return in_level ? totalkills : 0;
+        case MSTAT_TOTAL_ITEMS:
+            return in_level ? totalitems : 0;
+        case MSTAT_TOTAL_SECRETS:
+            return in_level ? totalsecret : 0;
+        case MSTAT_EPISODE:
+            return gameepisode;
+        case MSTAT_MAP:
+            return gamemap;
+        case MSTAT_LEVEL_SECONDS:
+            return in_level ? leveltime / TICRATE : 0;
+        case MSTAT_DEAD:
+            return (in_level && p->playerstate == PST_DEAD) ? 1 : 0;
+        case MSTAT_PAUSED:
+            return paused ? 1 : 0;
+        case MSTAT_NETGAME:
+            return netgame ? 1 : 0;
+        case MSTAT_IN_LOBBY:
+            return net_waiting_for_launch ? 1 : 0;
+        case MSTAT_NET_PLAYERS:
+        {
+            int n = 0, i;
+            if (!netgame) return 0;
+            for (i = 0; i < MAXPLAYERS; i++) if (playeringame[i]) n++;
+            return n;
+        }
+        default:
+            return 0;
+    }
+}
+
+//
+// Save-game hook: G_DoSaveGame calls this after the slot file is renamed
+// into place. The host page (the Perspective component) reads the file from
+// the in-memory filesystem and persists it on the gateway per user.
+//
+EM_JS(void, Mustry_SaveGameWritten, (int slot), {
+    if (typeof Module.onDoomSaveGame === 'function') {
+        Module.onDoomSaveGame(slot);
+    }
+});
diff --git a/src/doomtype.h b/src/doomtype.h
index 9947a070..0fe99d09 100644
--- a/src/doomtype.h
+++ b/src/doomtype.h
@@ -100,19 +100,26 @@
 
 #include <inttypes.h>
 
-#if defined(__cplusplus) || defined(__bool_true_false_are_defined)
-
-// Use builtin bool type with C++.
+#if defined(__cplusplus)
 
 typedef bool boolean;
 
 #else
 
-typedef enum 
-{
-    false, 
-    true
-} boolean;
+// Mustry: ONE boolean ABI for every C translation unit. Upstream picks a
+// 1-byte bool when <stdbool.h> was seen and a 4-byte enum otherwise; under
+// Emscripten <emscripten.h> pulls stdbool.h in (em_js.h), so files that
+// include it first disagreed with the rest about sizeof(boolean), and shared
+// globals such as playeringame[], netgame and paused read as garbage from
+// the other side ("Player 4 left the game" in single player). Doom also
+// relies on boolean being int-sized and memset()-able to -1
+// (R_InstallSpriteLump), and C23 makes true/false keywords: int it is.
+typedef int boolean;
+
+#if !defined(__bool_true_false_are_defined) && !(defined(__STDC_VERSION__) && __STDC_VERSION__ >= 202311L)
+#define false 0
+#define true 1
+#endif
 
 #endif
 
