diff --git a/src/doom/mustry_stats.c b/src/doom/mustry_stats.c
new file mode 100644
index 0000000..a465122
--- /dev/null
+++ b/src/doom/mustry_stats.c
@@ -0,0 +1,84 @@
+//
+// Mustry Doom: read-only player telemetry for the host page.
+//
+// Exported to JavaScript (see EXPORTED_FUNCTIONS in configure.ac) so the
+// Perspective component can poll the marine's state and publish it as
+// component outputs, which Ignition can then bind to tags and historize.
+// Everything here is a plain read of engine globals; nothing is mutated.
+//
+
+#include "doomstat.h"
+#include "d_player.h"
+#include "d_items.h"
+#include "p_local.h"
+
+enum
+{
+    MSTAT_IN_LEVEL = 0,   // 1 while a map is being played
+    MSTAT_HEALTH = 1,
+    MSTAT_ARMOR = 2,
+    MSTAT_AMMO = 3,       // ammo for the ready weapon, -1 when it needs none
+    MSTAT_WEAPON = 4,     // weapontype_t of the ready weapon (0 = fist)
+    MSTAT_KILLS = 5,
+    MSTAT_ITEMS = 6,
+    MSTAT_SECRETS = 7,
+    MSTAT_TOTAL_KILLS = 8,
+    MSTAT_TOTAL_ITEMS = 9,
+    MSTAT_TOTAL_SECRETS = 10,
+    MSTAT_EPISODE = 11,
+    MSTAT_MAP = 12,
+    MSTAT_LEVEL_SECONDS = 13,
+    MSTAT_DEAD = 14,      // 1 while the player is dead
+    MSTAT_PAUSED = 15
+};
+
+int Mustry_Stat(int id)
+{
+    player_t *p;
+    int in_level;
+
+    in_level = (gamestate == GS_LEVEL) ? 1 : 0;
+    p = &players[consoleplayer];
+
+    switch (id)
+    {
+        case MSTAT_IN_LEVEL:
+            return in_level;
+        case MSTAT_HEALTH:
+            return in_level ? p->health : 0;
+        case MSTAT_ARMOR:
+            return in_level ? p->armorpoints : 0;
+        case MSTAT_AMMO:
+            if (!in_level)
+                return 0;
+            if (weaponinfo[p->readyweapon].ammo == am_noammo)
+                return -1;
+            return p->ammo[weaponinfo[p->readyweapon].ammo];
+        case MSTAT_WEAPON:
+            return in_level ? (int) p->readyweapon : 0;
+        case MSTAT_KILLS:
+            return in_level ? p->killcount : 0;
+        case MSTAT_ITEMS:
+            return in_level ? p->itemcount : 0;
+        case MSTAT_SECRETS:
+            return in_level ? p->secretcount : 0;
+        case MSTAT_TOTAL_KILLS:
+            return in_level ? totalkills : 0;
+        case MSTAT_TOTAL_ITEMS:
+            return in_level ? totalitems : 0;
+        case MSTAT_TOTAL_SECRETS:
+            return in_level ? totalsecret : 0;
+        case MSTAT_EPISODE:
+            return gameepisode;
+        case MSTAT_MAP:
+            return gamemap;
+        case MSTAT_LEVEL_SECONDS:
+            return in_level ? leveltime / TICRATE : 0;
+        case MSTAT_DEAD:
+            return (in_level && p->playerstate == PST_DEAD) ? 1 : 0;
+        case MSTAT_PAUSED:
+            return paused ? 1 : 0;
+        default:
+            return 0;
+    }
+}
diff --git a/src/doomtype.h b/src/doomtype.h
index 9947a07..2f6f20f 100644
--- a/src/doomtype.h
+++ b/src/doomtype.h
@@ -100,9 +100,17 @@
 
 #include <inttypes.h>
 
-#if defined(__cplusplus) || defined(__bool_true_false_are_defined)
+#if defined(__cplusplus)
 
-// Use builtin bool type with C++.
+typedef bool boolean;
+
+#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 202311L
+
+// C23 makes true/false keywords of type bool. Doom relies on boolean being
+// int-sized and memset()-able to -1 (see R_InstallSpriteLump), so keep an int.
+typedef int boolean;
+
+#elif defined(__bool_true_false_are_defined)
 
 typedef bool boolean;
 
