diff --git a/src/heretic/mustry_stats.c b/src/heretic/mustry_stats.c
new file mode 100644
index 00000000..31d6c2fb
--- /dev/null
+++ b/src/heretic/mustry_stats.c
@@ -0,0 +1,111 @@
+//
+// Mustry Doom: read-only player telemetry for the host page (Heretic).
+//
+// Same ids and semantics as src/doom/mustry_stats.c so the component reads
+// both games through one table. Everything here is a plain read of engine
+// globals; nothing is mutated.
+//
+
+#include <emscripten.h>
+
+#include "doomdef.h"
+#include "p_local.h"
+#include "../d_loop.h"
+#include "../i_timer.h"
+#include "../net_client.h"
+
+enum
+{
+    MSTAT_IN_LEVEL = 0,
+    MSTAT_HEALTH = 1,
+    MSTAT_ARMOR = 2,
+    MSTAT_AMMO = 3,       // ammo for the ready weapon, -1 when it needs none (staff, gauntlets)
+    MSTAT_WEAPON = 4,     // weapontype_t of the ready weapon (0 = staff)
+    MSTAT_KILLS = 5,
+    MSTAT_ITEMS = 6,
+    MSTAT_SECRETS = 7,
+    MSTAT_TOTAL_KILLS = 8,
+    MSTAT_TOTAL_ITEMS = 9,
+    MSTAT_TOTAL_SECRETS = 10,
+    MSTAT_EPISODE = 11,
+    MSTAT_MAP = 12,
+    MSTAT_LEVEL_SECONDS = 13,
+    MSTAT_DEAD = 14,
+    MSTAT_PAUSED = 15,
+    MSTAT_NETGAME = 16,
+    MSTAT_IN_LOBBY = 17,
+    MSTAT_NET_PLAYERS = 18
+};
+
+int Mustry_Stat(int id)
+{
+    player_t *p;
+    int in_level;
+
+    in_level = (gamestate == GS_LEVEL && gametic > 0 && !net_waiting_for_launch) ? 1 : 0;
+    p = &players[consoleplayer];
+
+    switch (id)
+    {
+        case MSTAT_IN_LEVEL:
+            return in_level;
+        case MSTAT_HEALTH:
+            return in_level ? p->health : 0;
+        case MSTAT_ARMOR:
+            return in_level ? p->armorpoints : 0;
+        case MSTAT_AMMO:
+            if (!in_level)
+                return 0;
+            if (wpnlev1info[p->readyweapon].ammo == am_noammo)
+                return -1;
+            return p->ammo[wpnlev1info[p->readyweapon].ammo];
+        case MSTAT_WEAPON:
+            return in_level ? (int) p->readyweapon : 0;
+        case MSTAT_KILLS:
+            return in_level ? p->killcount : 0;
+        case MSTAT_ITEMS:
+            return in_level ? p->itemcount : 0;
+        case MSTAT_SECRETS:
+            return in_level ? p->secretcount : 0;
+        case MSTAT_TOTAL_KILLS:
+            return in_level ? totalkills : 0;
+        case MSTAT_TOTAL_ITEMS:
+            return in_level ? totalitems : 0;
+        case MSTAT_TOTAL_SECRETS:
+            return in_level ? totalsecret : 0;
+        case MSTAT_EPISODE:
+            return gameepisode;
+        case MSTAT_MAP:
+            return gamemap;
+        case MSTAT_LEVEL_SECONDS:
+            return in_level ? leveltime / TICRATE : 0;
+        case MSTAT_DEAD:
+            return (in_level && p->playerstate == PST_DEAD) ? 1 : 0;
+        case MSTAT_PAUSED:
+            return paused ? 1 : 0;
+        case MSTAT_NETGAME:
+            return netgame ? 1 : 0;
+        case MSTAT_IN_LOBBY:
+            return net_waiting_for_launch ? 1 : 0;
+        case MSTAT_NET_PLAYERS:
+        {
+            int n = 0, i;
+            if (!netgame) return 0;
+            for (i = 0; i < MAXPLAYERS; i++) if (playeringame[i]) n++;
+            return n;
+        }
+        default:
+            return 0;
+    }
+}
+
+//
+// Save-game hook: G_DoSaveGame calls this after SV_Close wrote the slot file
+// (hticsav<N>.hsg in -savedir). The host page reads it from the in-memory
+// filesystem and persists it on the gateway per user.
+//
+EM_JS(void, Mustry_SaveGameWritten, (int slot), {
+    if (typeof Module.onDoomSaveGame === 'function') {
+        Module.onDoomSaveGame(slot);
+    }
+});
