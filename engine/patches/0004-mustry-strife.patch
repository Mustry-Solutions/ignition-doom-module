diff --git a/src/strife/mustry_stats.c b/src/strife/mustry_stats.c
new file mode 100644
index 00000000..951a25b7
--- /dev/null
+++ b/src/strife/mustry_stats.c
@@ -0,0 +1,129 @@
+//
+// Mustry Doom: read-only player telemetry for the host page (Strife).
+//
+// Same ids and semantics as src/doom/mustry_stats.c so the component reads
+// every game through one table, plus two of Strife's own: gold and the
+// quest flags. Strife keeps a kill count but no item/secret counters and no
+// intermission totals. Everything here is a plain read of engine globals.
+//
+
+#include <emscripten.h>
+
+#include "doomstat.h"
+#include "d_player.h"
+#include "d_items.h"
+#include "p_local.h"
+#include "../d_loop.h"
+#include "../i_timer.h"
+#include "../net_client.h"
+
+enum
+{
+    MSTAT_IN_LEVEL = 0,
+    MSTAT_HEALTH = 1,
+    MSTAT_ARMOR = 2,
+    MSTAT_AMMO = 3,       // ammo for the ready weapon, -1 when it needs none
+    MSTAT_WEAPON = 4,
+    MSTAT_KILLS = 5,
+    MSTAT_ITEMS = 6,
+    MSTAT_SECRETS = 7,
+    MSTAT_TOTAL_KILLS = 8,
+    MSTAT_TOTAL_ITEMS = 9,
+    MSTAT_TOTAL_SECRETS = 10,
+    MSTAT_EPISODE = 11,
+    MSTAT_MAP = 12,
+    MSTAT_LEVEL_SECONDS = 13,
+    MSTAT_DEAD = 14,
+    MSTAT_PAUSED = 15,
+    MSTAT_NETGAME = 16,
+    MSTAT_IN_LOBBY = 17,
+    MSTAT_NET_PLAYERS = 18,
+    MSTAT_CLASS = 19,         // Hexen only
+    MSTAT_GOLD = 20,          // Strife: gold carried (the COIN inventory item)
+    MSTAT_QUEST_FLAGS = 21    // Strife: player_t.questflags
+};
+
+static int Gold(player_t *p)
+{
+    int i;
+    for (i = 0; i < NUMINVENTORY; i++)
+    {
+        if (p->inventory[i].sprite == SPR_COIN)
+            return p->inventory[i].amount;
+    }
+    return 0;
+}
+
+int Mustry_Stat(int id)
+{
+    player_t *p;
+    int in_level;
+
+    in_level = (gamestate == GS_LEVEL && gametic > 0 && !net_waiting_for_launch) ? 1 : 0;
+    p = &players[consoleplayer];
+
+    switch (id)
+    {
+        case MSTAT_IN_LEVEL:
+            return in_level;
+        case MSTAT_HEALTH:
+            return in_level ? p->health : 0;
+        case MSTAT_ARMOR:
+            return in_level ? (int) p->armorpoints : 0;
+        case MSTAT_AMMO:
+            if (!in_level)
+                return 0;
+            if (weaponinfo[p->readyweapon].ammo == am_noammo)
+                return -1;
+            return p->ammo[weaponinfo[p->readyweapon].ammo];
+        case MSTAT_WEAPON:
+            return in_level ? (int) p->readyweapon : 0;
+        case MSTAT_KILLS:
+            return in_level ? (int) p->killcount : 0;
+        case MSTAT_ITEMS:
+        case MSTAT_SECRETS:
+        case MSTAT_TOTAL_ITEMS:
+        case MSTAT_TOTAL_SECRETS:
+            return 0;
+        case MSTAT_TOTAL_KILLS:
+            return in_level ? totalkills : 0;
+        case MSTAT_EPISODE:
+            return 1; // Strife has no episodes
+        case MSTAT_MAP:
+            return gamemap;
+        case MSTAT_LEVEL_SECONDS:
+            return in_level ? leveltime / TICRATE : 0;
+        case MSTAT_DEAD:
+            return (in_level && p->playerstate == PST_DEAD) ? 1 : 0;
+        case MSTAT_PAUSED:
+            return paused ? 1 : 0;
+        case MSTAT_NETGAME:
+            return netgame ? 1 : 0;
+        case MSTAT_IN_LOBBY:
+            return net_waiting_for_launch ? 1 : 0;
+        case MSTAT_NET_PLAYERS:
+        {
+            int n = 0, i;
+            if (!netgame) return 0;
+            for (i = 0; i < MAXPLAYERS; i++) if (playeringame[i]) n++;
+            return n;
+        }
+        case MSTAT_GOLD:
+            return in_level ? Gold(p) : 0;
+        case MSTAT_QUEST_FLAGS:
+            return in_level ? p->questflags : 0;
+        default:
+            return 0;
+    }
+}
+
+//
+// Save-game hook: G_DoSaveGame calls this once the slot's folder
+// (strfsav<N>.ssg in -savedir) is complete. The host page reads every file
+// in it from the in-memory filesystem and persists them on the gateway.
+//
+EM_JS(void, Mustry_SaveGameWritten, (int slot), {
+    if (typeof Module.onDoomSaveGame === 'function') {
+        Module.onDoomSaveGame(slot);
+    }
+});
