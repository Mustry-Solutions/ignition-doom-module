      {
        "type": "embr.chart.chart-js",
        "version": 0,
        "props": {
          "type": "line",
          "data": {
            "labels": [],
            "datasets": []
          },
          "options": {
            "responsive": true,
            "maintainAspectRatio": false,
            "animation": false,
            "parsing": true,
            "plugins": {
              "legend": {
                "position": "top",
                "align": "end",
                "labels": {
                  "color": "#e6e9ef",
                  "boxWidth": 10,
                  "boxHeight": 10,
                  "usePointStyle": true
                }
              },
              "tooltip": {
                "mode": "index",
                "intersect": false
              }
            },
            "scales": {
              "x": {
                "type": "time",
                "time": {
                  "unit": "minute",
                  "displayFormats": {
                    "minute": "HH:mm"
                  }
                },
                "ticks": {
                  "color": "#8b95a5",
                  "maxRotation": 0
                },
                "grid": {
                  "color": "#1f2630"
                }
              },
              "y": {
                "min": 0,
                "suggestedMax": 100,
                "ticks": {
                  "color": "#8b95a5"
                },
                "grid": {
                  "color": "#1f2630"
                }
              }
            }
          },
          "style": {
            "backgroundColor": "transparent"
          }
        },
        "propConfig": {
          "props.data.datasets": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "now(2000)"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tplayer = self.view.params.player\n\tbase = \"[default]Doom/Players/%s/\" % player\n\tseries = [(\"Health\", \"#e24b4a\"), (\"Armor\", \"#2ecc71\"), (\"Ammo\", \"#f1c40f\")]\n\tend = system.date.now()\n\tstart = system.date.addMinutes(end, -5)\n\ttry:\n\t\tds = system.tag.queryTagHistory(paths=[base + name for name, _ in series], startDate=start, endDate=end, returnFormat=\"Wide\", aggregationMode=\"LastValue\", returnSize=-1)\n\texcept Exception:\n\t\treturn []\n\tpds = system.dataset.toPyDataSet(ds)\n\tout = []\n\tfor i, (name, color) in enumerate(series):\n\t\tpts = []\n\t\tfor row in pds:\n\t\t\ty = row[i + 1]\n\t\t\tif y is None:\n\t\t\t\tcontinue\n\t\t\tt = row[0]\n\t\t\tpts.append({\"x\": t.getTime() if hasattr(t, \"getTime\") else t, \"y\": y})\n\t\tout.append({\"label\": name, \"data\": pts, \"borderColor\": color, \"backgroundColor\": color + \"33\", \"borderWidth\": 2, \"pointRadius\": 0, \"stepped\": True, \"tension\": 0})\n\treturn out"
                }
              ]
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.requirements.embr} && {view.custom.requirements.history}"
              }
            }
          }
        },
