                "expression": "if({view.custom.requirements.embr} && {view.custom.requirements.history}, \"\", if(!{view.custom.requirements.embr} && !{view.custom.requirements.history}, \"The trend needs two optional modules: Embr Charts (the chart) and a tag history provider such as the Mustry TimescaleDB Historian (the data). The grey pills in the header show what is missing; everything else on this page works without them.\", if(!{view.custom.requirements.embr}, \"History is on (\" + {view.custom.requirements.historian} + \") but Embr Charts is not installed, so there is nothing to draw the trend with. Install Embr Charts (free, Ignition 8.3 build) and reload.\", \"Embr Charts is installed but this gateway has no tag history provider, so there is nothing to trend. Add one, for instance the Mustry TimescaleDB Historian, and reload: the demo enables history on its tags when the view opens.\")))"
              }
            }
          }
        }
