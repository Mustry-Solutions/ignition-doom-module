{
  "custom": {},
  "params": {
    "iwad": "",
    "pwad": "",
    "player": "WadTester",
    "game": "doom"
  },
  "props": {
    "defaultSize": {
      "width": 1280,
      "height": 640
    }
  },
  "propConfig": {
    "params.iwad": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.pwad": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.player": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.game": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "root": {
    "type": "ia.container.coord",
    "version": 0,
    "props": {
      "style": {
        "backgroundColor": "#0b0d10"
      }
    },
    "meta": {
      "name": "root"
    },
    "children": [
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "DOOM",
          "style": {
            "fontFamily": "Inter, 'Segoe UI', system-ui, sans-serif",
            "color": "#e24b4a",
            "fontSize": "34px",
            "fontWeight": "800",
            "letterSpacing": "0.12em",
            "cursor": "pointer"
          }
        },
        "meta": {
          "name": "title"
        },
        "position": {
          "x": 24,
          "y": 18,
          "width": 140,
          "height": 44
        },
        "events": {
          "dom": {
            "onClick": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tsystem.perspective.navigate(page='/')"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "",
          "style": {
            "fontFamily": "Inter, 'Segoe UI', system-ui, sans-serif",
            "color": "#8b95a5",
            "fontSize": "13px"
          }
        },
        "meta": {
          "name": "subtitle"
        },
        "position": {
          "x": 170,
          "y": 22,
          "width": 700,
          "height": 20
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "upper({view.params.game}) + \" \u00b7 \" + if(coalesce({../doom.props.output.iwad}, \"\") != \"\", \"IWAD \" + {../doom.props.output.iwad} + \".wad\", if({view.params.iwad} = \"\", \"the game's default IWAD\", \"IWAD \" + {view.params.iwad})) + if({view.params.pwad} != \"\", \" + PWAD \" + {view.params.pwad}, \"\") + \" \u00b7 via the gateway's wads folder\""
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "Doom and Heretic ship their shareware episodes; Hexen and Strife need your WAD. Files go in data/modules/com.mustrysolutions.doom/wads/ on the gateway.",
          "style": {
            "fontFamily": "Inter, 'Segoe UI', system-ui, sans-serif",
            "color": "#8b95a5",
            "fontSize": "12px"
          }
        },
        "meta": {
          "name": "subtitle2"
        },
        "position": {
          "x": 170,
          "y": 42,
          "width": 900,
          "height": 18
        }
      },
      {
        "type": "mustrysolutions.perspective.fun.doom",
        "version": 0,
        "props": {
          "config": {
            "autoStart": false,
            "showHud": true,
            "warp": true,
            "iwad": "",
            "pwads": [],
            "player": "",
            "game": "doom"
          },
          "data": {
            "controls": {
              "forward": false,
              "backward": false,
              "strafeLeft": false,
              "strafeRight": false,
              "turnLeft": false,
              "turnRight": false,
              "fire": false,
              "use": false,
              "run": false,
              "menu": false,
              "confirm": false,
              "weapon": 0
            }
          },
          "state": {},
          "style": {
            "borderRadius": "12px",
            "overflow": "hidden"
          }
        },
        "propConfig": {
          "props.config.iwad": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.iwad"
              }
            }
          },
          "props.config.pwads": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.pwad"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn [value] if value else []"
                }
              ]
            }
          },
          "props.config.player": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.player"
              }
            }
          },
          "custom.availableWadsText": {
            "binding": {
              "type": "property",
              "config": {
                "path": "this.props.output.availableWads"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn ', '.join(str(w) for w in (value or []))"
                }
              ]
            }
          },
          "props.config.game": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.game"
              }
            }
          }
        },
        "custom": {
          "availableWadsText": ""
        },
        "meta": {
          "name": "doom"
        },
        "position": {
          "x": 24,
          "y": 76,
          "width": 800,
          "height": 528
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "",
          "style": {
            "fontFamily": "Inter, 'Segoe UI', system-ui, sans-serif",
            "color": "#e6e9ef",
            "backgroundColor": "#0f1318",
            "borderRadius": "12px"
          }
        },
        "meta": {
          "name": "termCard"
        },
        "position": {
          "x": 848,
          "y": 76,
          "width": 408,
          "height": 528
        }
      },
      {
        "type": "ia.display.label",
        "version": 0,
        "props": {
          "text": "",
          "style": {
            "fontFamily": "ui-monospace, Menlo, Consolas, monospace",
            "color": "#7ee787",
            "fontSize": "11px",
            "whiteSpace": "pre-wrap",
            "lineHeight": "1.35"
          }
        },
        "meta": {
          "name": "outputs"
        },
        "position": {
          "x": 862,
          "y": 86,
          "width": 380,
          "height": 510
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "\"output.state: \" + {../doom.props.output.state} + \"\\noutput.message: \" + {../doom.props.output.message} + \"\\noutput.iwad: \" + coalesce({../doom.props.output.iwad}, \"\") + \"\\noutput.wadError: \" + coalesce({../doom.props.output.wadError}, \"\") + \"\\noutput.availableWads: \" + coalesce({../doom.custom.availableWadsText}, \"\") + \"\\noutput.inLevel: \" + {../doom.props.output.inLevel} + \"  \u00b7  episode: \" + {../doom.props.output.episode} + \"  \u00b7  map: \" + {../doom.props.output.map} + \"\\n\\n/game/heretic       Heretic shareware (bundled)\\n\\nThe gateway reads IWADs and PWADs from\\ndata/modules/com.mustrysolutions.doom/wads/\\n\\n/wad/doom2          play DOOM2.WAD\\n/wad/doom2/av       ... with av.wad\\n/wad/plutonia       not there? shareware + output.wadError\""
              }
            }
          }
        }
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tdoom.setupTags()\n\tdoom.setupPlayer(self.view.params.player)"
          }
        }
      }
    }
  }
}
